<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Normál oldal tartalma -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/imageCard"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivSelectedPill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:contentDescription="A lefényképezett gyógyszer" />



        </com.google.android.material.card.MaterialCardView>

        <!--
        A kontraszt- és fényerővezérlőknek a fő ConstraintLayout
        közvetlen gyermekének kell lenniük. A MaterialCardView belsejében
        FrameLayout szabályok érvényesek, ezért ott a 0dp szélesség és a
        constraint attribútumok miatt a blokk láthatatlan volt.
        -->
        <LinearLayout
            android:id="@+id/pillFilterControls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageCard">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Kontraszt"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/slider_contrast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:max="100"
                android:progress="50" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_flash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:contentDescription="Fényerő növelése"
                android:enabled="false"
                android:src="@android:drawable/ic_menu_camera"
                app:backgroundTint="@android:color/darker_gray"
                app:fabSize="mini" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@id/pillFilterControls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenCamera"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Kamera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenGallery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Galéria" />

        </LinearLayout>

        <TextView
            android:id="@+id/instruction_TextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:text="Fotózd le a gyógyszert vagy válassz képet a galériából az elemzéshez!"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/button_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:fillViewport="true"
            android:background="?attr/colorSurfaceContainerLow"
            app:layout_constraintTop_toBottomOf="@id/instruction_TextView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvResultName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ide kerül majd az elemzés eredménye..."
                android:textSize="16sp"
                android:textColor="?attr/colorOnBackground"
                android:lineSpacingExtra="6dp"
                android:textStyle="bold" />

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- TELJES KÉPERNYŐS KAMERA -->
    <FrameLayout
        android:id="@+id/fullCameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 4 SARKOS SEGÉDKERET A LAP / ARUCO-S PAPÍR BEIGAZÍTÁSÁHOZ -->
        <!-- 4 SARKOS SEGÉDKERET A LAP / ARUCO-S PAPÍR BEIGAZÍTÁSÁHOZ -->
        <FrameLayout
            android:id="@+id/cornerGuideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:elevation="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Bal felső sarok -->
                <View
                    android:layout_width="72dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|start"
                    android:background="#FFFFFF" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="72dp"
                    android:layout_gravity="top|start"
                    android:background="#FFFFFF" />

                <!-- Jobb felső sarok -->
                <View
                    android:layout_width="72dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:background="#FFFFFF" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="72dp"
                    android:layout_gravity="top|end"
                    android:background="#FFFFFF" />

                <!-- Bal alsó sarok -->
                <View
                    android:layout_width="72dp"
                    android:layout_height="6dp"
                    android:layout_gravity="bottom|start"
                    android:background="#FFFFFF" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom|start"
                    android:background="#FFFFFF" />

                <!-- Jobb alsó sarok -->
                <View
                    android:layout_width="72dp"
                    android:layout_height="6dp"
                    android:layout_gravity="bottom|end"
                    android:background="#FFFFFF" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom|end"
                    android:background="#FFFFFF" />

            </FrameLayout>

        </FrameLayout>

        <View
            android:id="@+id/levelIndicator"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="48dp"
            android:background="@drawable/level_indicator_bg"
            android:elevation="30dp" />

        <TextView
            android:id="@+id/tvCameraStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="106dp"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:background="#99000000"
            android:text="Igazítsd vízszintbe a telefont"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!--
        Fix kameragomb-sorrend. A gyermekek XML-sorrendje mindig:
        1. Fénykép készítése
        2. Vissza

        A Java-kód nem mozgathatja és nem rendezheti át ezeket.
        -->
        <LinearLayout
            android:id="@+id/cameraButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="34dp"
            android:elevation="30dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTakePhotoFull"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Fénykép készítése"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseCamera"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="← Vissza" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>